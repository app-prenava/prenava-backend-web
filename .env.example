APP_NAME=nuri-backend
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta


LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=nuri_db
DB_USERNAME=nuri
DB_PASSWORD=
DB_ROOT_PASSWORD=

BROADCAST_DRIVER=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
SESSION_DRIVER=redis
SESSION_LIFETIME=120

CACHE_DRIVER=redis
CACHE_PREFIX=
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_URL=tcp://redis:6379

REDIS_DB=0
REDIS_CACHE_DB=1

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_DEFAULT_REGION=us-east-1

VITE_APP_NAME="${APP_NAME}"

URL_ML_SPORTS=http://host.docker.internal:8085

JWT_SECRET=

AUTH_TTL_IBU_HAMIL_SECONDS=2592000
AUTH_TTL_UMUM_SECONDS=2592000
AUTH_TTL_BIDAN_SECONDS=43200
AUTH_TTL_DINKES_SECONDS=43200
AUTH_TTL_DEFAULT_SECONDS=2592000

THREAD_VIEW_TTL_HOURS=24
THREAD_LIKE_TTL_HOURS=24
WALLET_SYNC_TIME=15:43:00

# Machine Learning Services
ML_API_URL=http://127.0.0.1:5000/predict       # ML Skrining Stunting (Flask - Port 5000)
URL_ML_STUNTING=http://127.0.0.1:5000          # ML Skrining Stunting Base
URL_ML_ANEMIA=http://127.0.0.1:9001            # DL Deteksi Anemia Mata (FastAPI - Port 9001)
URL_ML_SPORTS=http://127.0.0.1:8082            # ML Rekomendasi Olahraga (FastAPI - Port 8082)
URL_ML_RAG=http://127.0.0.1:8002               # Voice Medical RAG Assistant (FastAPI - Port 8002)

